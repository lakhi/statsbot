APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Azure OpenAI (required for GPT proxy in routes/api.php)
AZURE_API_KEY=
AZURE_ENDPOINT=
AZURE_DEPLOYMENT=
AZURE_API_VERSION=
AZURE_MODEL=
# Reasoning models (e.g. gpt-5-mini) only: minimal | low | medium | high.
# Leave EMPTY for chat-tuned models (e.g. gpt-4o) - the proxy then sends temperature=0.7 instead.
# Reasoning tokens count toward completion_tokens (and thus each student's token budget), so keep this low.
AZURE_REASONING_EFFORT=
# Sampling temperature for non-reasoning models (ignored when AZURE_REASONING_EFFORT is set).
# Keep at or below 0.3 when TUTOR_STRUCTURED_OUTPUT=json_object: without a schema to
# enforce the shape, higher values make the model emit invalid JSON and the two answer
# layers collapse into one. Measured on mistral-small-2503: 9/16 valid at 0.7, 16/16 at 0.3.
AZURE_TEMPERATURE=0.7

# Per-student token budget (set on registration)
TOKEN_LIMIT=0

# --- Course-material grounding (RAG). See config/tutor.php. ---
# Master switch. false restores the ungrounded behaviour with no file change.
RAG_ENABLED=false
# Index basename WITHOUT extension; the retriever reads <path>.f32 and <path>.json.
RAG_INDEX_PATH=
# How many passages may be injected per turn.
RAG_TOP_K=3
# Similarity floor below which the course-materials layer stays empty.
# 0.35 separated all 22 pilot gold questions, but on a thin margin - re-measure
# when the corpus grows.
RAG_MIN_SCORE=0.35

# Embeddings deployment. Normally the SAME Azure resource as the chat model, so
# retrieval adds no new subprocessor and needs no consent change.
# text-embedding-3-small is NOT interchangeable here: on the pilot gold set its
# out-of-corpus questions outscored its true positives, so no floor could stop
# the tutor attributing answers to materials that do not contain them.
#
# The two split apart when the chat model is an OPEN-WEIGHT one: those need a
# Foundry (AIServices) resource, while text-embedding-3-* can only be deployed on
# an Azure OpenAI resource. Set these to keep embeddings pointed at the OpenAI
# resource while AZURE_ENDPOINT/AZURE_API_KEY move to Foundry. Both fall back to
# AZURE_ENDPOINT/AZURE_API_KEY when left empty, so a single-resource .env is
# unaffected.
AZURE_EMBED_ENDPOINT=
AZURE_EMBED_API_KEY=
AZURE_EMBED_DEPLOYMENT=statsbot-embed-3-large
AZURE_EMBED_MODEL=text-embedding-3-large
AZURE_EMBED_API_VERSION=2024-10-21
AZURE_EMBED_DIMENSIONS=3072
AZURE_EMBED_TIMEOUT=10

# How the two answer layers are separated - by parsing, never by prose formatting.
#
#   json_schema   Schema-enforced. Azure OpenAI models only (gpt-5-mini, gpt-oss).
#   json_object   Free-form JSON, shape requested in the prompt. Required for every
#                 open-weight model on Foundry (Mistral, Llama, Phi): they REJECT
#                 json_schema with an HTTP 400 rather than ignoring it, so leaving
#                 this on json_schema makes every request fail.
#   off           No response_format; parse() falls back to prose (general layer only).
#
# Legacy values still work: true -> json_schema, false -> off.
TUTOR_STRUCTURED_OUTPUT=json_schema
